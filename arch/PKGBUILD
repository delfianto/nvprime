pkgname=nvprime
pkgver=0.4.2
pkgrel=1
pkgdesc='GPU and CPU tuning wrapper for Linux gaming'
arch=('x86_64')
url='https://github.com/delfianto/nvprime'
license=('MIT')
depends=('glibc' 'libgcc' 'systemd' 'dbus')
makedepends=('cargo')
optdepends=('nvidia-utils: NVML support for NVIDIA GPUs')
provides=("nvprime-bin=$pkgver-$pkgrel")
conflicts=('nvprime-bin')
replaces=('nvprime-bin')
options=('!strip' '!debug')
backup=('etc/nvprime.toml')
install=nvprime.install

# Run makepkg from the arch directory of the nvprime checkout.
prepare() {
    cd "$startdir/.."
    cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
    cd "$startdir/.."
    cargo build --frozen --release --bins --target-dir "$srcdir/target"
}

package() {
    cd "$startdir/.."
    install -Dm0755 "$srcdir/target/release/nvprime" "$pkgdir/usr/bin/nvprime"
    install -Dm0755 "$srcdir/target/release/nvprimed" "$pkgdir/usr/bin/nvprimed"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 system/nvprime.toml "$pkgdir/etc/nvprime.toml"
    install -Dm0644 system/nvprime.service "$pkgdir/usr/lib/systemd/system/nvprime.service"
    install -Dm0644 system/com.github.nvprime.conf "$pkgdir/usr/share/dbus-1/system.d/com.github.nvprime.conf"
    install -Dm0644 "$startdir/10-nvprime-stop.hook" "$pkgdir/usr/share/libalpm/hooks/10-nvprime-stop.hook"
    install -Dm0644 "$startdir/nvprime.install" "$pkgdir/usr/share/libalpm/scripts/nvprime-install"
}
