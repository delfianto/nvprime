pkgname=nvprime
pkgver=0.2.1
pkgrel=2
pkgdesc='GPU and CPU tuning wrapper for Linux gaming'
arch=('x86_64')
url='https://github.com/delfianto/nvprime'
license=('MIT')
depends=('glibc' 'libgcc' 'systemd' 'dbus')
optdepends=('nvidia-utils: NVML support for NVIDIA GPUs')
provides=("nvprime-bin=$pkgver-$pkgrel")
conflicts=('nvprime-bin')
replaces=('nvprime-bin')
options=('!strip' '!debug')
_archive="nvprime-v$pkgver-linux-x86_64"
source=("$url/releases/download/arch-v$pkgver-$pkgrel/$_archive.tar.gz")
sha256sums=('d541ae98645f844961d8585eee060f8bd2dbfb65a26129b943954b3d31de4f2b')

package() {
    cd "$srcdir/$_archive"
    install -Dm0755 nvprime "$pkgdir/usr/bin/nvprime"
    install -Dm0755 nvprime-sys "$pkgdir/usr/bin/nvprime-sys"
    install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm0644 nvprime.service "$pkgdir/usr/lib/systemd/system/nvprime.service"
    sed -i 's|^ExecStart=/usr/local/bin/nvprime-sys$|ExecStart=/usr/bin/nvprime-sys|' \
        "$pkgdir/usr/lib/systemd/system/nvprime.service"
    install -Dm0644 com.github.nvprime.conf "$pkgdir/usr/share/dbus-1/system.d/com.github.nvprime.conf"
}
